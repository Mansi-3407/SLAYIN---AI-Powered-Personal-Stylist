# Copy to .env and fill in values.

# --- App ---
APP_ENV=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# --- Database (SQLite for MVP; e.g. postgresql+psycopg://user:pass@host/slayin later) ---
DATABASE_URL=sqlite:///./data/slayin.db

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- AI models ---
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
DEVICE=cpu

# --- Uploads ---
MAX_UPLOAD_MB=10

# --- Logging ---
LOG_LEVEL=INFO
